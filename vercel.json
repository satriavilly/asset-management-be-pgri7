{
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm run vercel-build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
